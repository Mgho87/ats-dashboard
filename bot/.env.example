# ALMUTARJEM Telegram bot — copy to ".env" (gitignored) OR set these in the cPanel app's Environment.
# Secrets stay out of git. On cPanel, prefer the app's Environment variables (process.env).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_TIME_UAE=20:00

# --- Report output format ---
# text    = legacy text report (DEFAULT / rollback path — unchanged behaviour)
# png     = generate the Daily Office Report dashboard image and send it (sendPhoto,
#           auto-fallback to sendDocument for very tall images); sends ONLY the PNG
# dry-run = build + archive the PNG but DO NOT send (no token needed)
# Keep this on 'text' until the PNG path is validated AND the Telegram token is valid.
DAILY_REPORT_MODE=text

# --- Reliability engine (optional; sensible defaults shown) ---
# How long to keep retrying a failing send (minutes, from the first attempt) before giving up + alerting.
BOT_MAX_RETRY_MIN=210
# Don't START a report more than this many minutes late (avoids sending a stale report after a long outage).
BOT_CATCHUP_MAX_LATE_MIN=300
# Backup scheduler tick interval when the persistent app is running (ms). Primary trigger is cPanel cron.
BOT_TICK_INTERVAL_MS=300000

# --- Google Sheet data (reused from the dashboard; public gviz/CSV, no credentials needed) ---
SPREADSHEET_ID=1p7SrQZFavFmslQ84FNMIWtAVHcIhUOLKrSM6e3vuH4Q
SHEET_TRANSACTIONS=Transactions
SHEET_EXPENSES=Expenses
SHEET_SETTINGS=Settings
RAWAN_GVIZ_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vT0U4OaCeJa5z9Uj9e2URY8gSo4NxpYMFi35JPEEsHeDeFIcztbWhsv4jWA8lXUP9l8kLRpSuZPjTOw/pub?output=csv

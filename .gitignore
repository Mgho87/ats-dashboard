# dependencies
node_modules/

# secrets / local config (env vars are set in the host dashboard, not committed)
.env

# runtime logs
*.log
server.log
tunnel.log

# runtime data (regenerated by the app; never commit business data)
data/audit-history.json
data/last-snapshot.json
*.xlsx
*.xls
*.csv

# local tunnel binary (large; not needed in the cloud)
cloudflared.exe

# misc
.playwright-mcp/
.DS_Store
almutarjem-audit/

# Telegram bot runtime state — never commit (per-server, regenerated at runtime)
bot/.sent-*
.sent-*
bot/state.json
bot/state.json.*.tmp
bot/events.log
